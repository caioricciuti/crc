{
  "about": "What crc accepts in manifest.json. Each case sets keys on the base manifest (null removes the key) and says whether crc installs the result. crc's manifest tests run every case through manifest::parse, and crc-extensions' build-registry.py runs the same file through its own checks, so a rule changed on one side and not the other fails a test. crc-extensions keeps a copy in scripts/contract/; its CI compares the copy with this file.",
  "base": {
    "id": "author.sample",
    "name": "Sample",
    "version": "1.2.3",
    "description": "A sample extension.",
    "authors": ["Author"],
    "license": "MIT",
    "api": 1,
    "entry": "sample.wasm",
    "capabilities": ["selection.read", "selection.replace"],
    "commands": [{ "id": "run", "title": "Run" }]
  },
  "cases": [
    { "name": "the base manifest", "set": {}, "ok": true },
    { "name": "every capability crc knows", "set": { "capabilities": ["selection.read", "selection.replace", "document.read", "document.edit"] }, "ok": true },
    { "name": "an unknown capability", "set": { "capabilities": ["selection.read", "network"] }, "ok": false },
    { "name": "a capability that is not a string", "set": { "capabilities": ["selection.read", 1] }, "ok": false },
    { "name": "no capabilities key", "set": { "capabilities": null }, "ok": false },
    { "name": "another API", "set": { "api": 2 }, "ok": false },
    { "name": "api as true", "set": { "api": true }, "ok": false },
    { "name": "api as a string", "set": { "api": "1" }, "ok": false },
    { "name": "no api", "set": { "api": null }, "ok": false },
    { "name": "an id with one part", "set": { "id": "sample" }, "ok": false },
    { "name": "an id with capitals", "set": { "id": "Author.Sample" }, "ok": false },
    { "name": "an id with a dash inside a part", "set": { "id": "my-name.a-b-c" }, "ok": true },
    { "name": "an id with a leading dash", "set": { "id": "-author.sample" }, "ok": false },
    { "name": "an id with a double dash", "set": { "id": "author.sam--ple" }, "ok": false },
    { "name": "an id ending in a newline", "set": { "id": "author.sample\n" }, "ok": false },
    { "name": "an id of 100 characters", "set": { "id": "a.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" }, "ok": true },
    { "name": "an id of 101 characters", "set": { "id": "a.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" }, "ok": false },
    { "name": "a version of two parts", "set": { "version": "1.2" }, "ok": false },
    { "name": "a version with a letter", "set": { "version": "1.2.3a" }, "ok": false },
    { "name": "a version with non-ASCII digits", "set": { "version": "１.2.3" }, "ok": false },
    { "name": "a version ending in a newline", "set": { "version": "1.2.3\n" }, "ok": false },
    { "name": "an entry with a slash", "set": { "entry": "lib/sample.wasm" }, "ok": false },
    { "name": "an entry with a backslash", "set": { "entry": "lib\\sample.wasm" }, "ok": false },
    { "name": "an entry that is not .wasm", "set": { "entry": "sample.so" }, "ok": false },
    { "name": "no name", "set": { "name": null }, "ok": false },
    { "name": "a name that is not a string", "set": { "name": 7 }, "ok": false },
    { "name": "no description", "set": { "description": null }, "ok": false },
    { "name": "no license", "set": { "license": null }, "ok": false },
    { "name": "no authors", "set": { "authors": null }, "ok": true },
    { "name": "no commands", "set": { "commands": [] }, "ok": false },
    { "name": "a command id with a capital", "set": { "commands": [{ "id": "Run", "title": "Run" }] }, "ok": false },
    { "name": "a command id with a dash", "set": { "commands": [{ "id": "run-it", "title": "Run" }] }, "ok": false },
    { "name": "a command id ending in a newline", "set": { "commands": [{ "id": "run\n", "title": "Run" }] }, "ok": false },
    { "name": "a command with a blank title", "set": { "commands": [{ "id": "run", "title": "   " }] }, "ok": false },
    { "name": "a command with no title", "set": { "commands": [{ "id": "run" }] }, "ok": false },
    { "name": "a command listed twice", "set": { "commands": [{ "id": "run", "title": "Run" }, { "id": "run", "title": "Again" }] }, "ok": false },
    { "name": "a known icon", "set": { "icon": "table" }, "ok": true },
    { "name": "an unknown icon", "set": { "icon": "skull" }, "ok": false },
    { "name": "an https homepage", "set": { "homepage": "https://example.com" }, "ok": true },
    { "name": "an http homepage", "set": { "homepage": "http://example.com" }, "ok": false },
    { "name": "a homepage that is not a string", "set": { "homepage": 5 }, "ok": false },
    { "name": "a preview", "set": { "capabilities": ["document.read", "preview.show"], "commands": [{ "id": "preview", "title": "Open Preview" }] }, "ok": true },
    { "name": "a preview without a preview command", "set": { "capabilities": ["document.read", "preview.show"] }, "ok": false },
    { "name": "a preview without document.read", "set": { "capabilities": ["selection.read", "preview.show"], "commands": [{ "id": "preview", "title": "Open Preview" }] }, "ok": false }
  ]
}
