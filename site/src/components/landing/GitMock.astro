---
// The Source Control panel: branch, staged and working-tree changes, a hunk
// with its own Stage button, and the commit box. Illustrative.
---

<div class="panel" aria-hidden="true">
  <div class="seg"><span>Explorer</span><span class="on">Source Control</span></div>
  <div class="branch">
    <svg viewBox="0 0 16 16" width="14" height="14"><path fill="currentColor" d="M5 3.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm0 2.122a2.25 2.25 0 1 0-1.5 0v5.256a2.25 2.25 0 1 0 1.5 0V9.5c0-.69.56-1.25 1.25-1.25h3.5A2.75 2.75 0 0 0 12.5 5.5v-.128a2.25 2.25 0 1 0-1.5 0v.128c0 .69-.56 1.25-1.25 1.25h-3.5c-.45 0-.874.107-1.25.297V5.372ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM11.75 3.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z"/></svg>
    <b>main</b><span class="ahead">↑1</span>
  </div>
  <div class="group">Staged <span>1</span></div>
  <div class="file"><span class="m a">A</span> src/harvest.rs <em>+38</em></div>
  <div class="group">Changes <span>2</span></div>
  <div class="file sel"><span class="m">M</span> src/main.rs <em>+4 −1</em></div>
  <div class="file"><span class="m">M</span> garden.yaml <em>+1</em></div>
  <div class="hunk">
    <div class="hunk-head"><span>@@ -8,6 +8,9 @@</span><span class="stage">Stage hunk</span></div>
    <div class="h"><span class="k">pub</span> plant: <span class="t">String</span>,</div>
    <div class="h del"><span class="k">pub</span> note: <span class="t">String</span>,</div>
    <div class="h add"><span class="k">pub</span> note: <span class="t">Option</span>&lt;<span class="t">String</span>&gt;,</div>
    <div class="h add"><span class="k">pub</span> harvested: <span class="t">bool</span>,</div>
  </div>
  <div class="commit">
    <span class="msg">Track harvest dates per bed</span>
    <span class="go">Commit <kbd>⌘↩</kbd></span>
  </div>
</div>

<style>
  .panel {
    border-radius: 12px;
    background: var(--sidebar);
    border: 1px solid var(--line-2);
    box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.8);
    padding: 0.8rem;
    font-size: 0.82rem;
    color: #b7c0bc;
  }
  .seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 3px;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.25);
    font-size: 0.78rem;
    text-align: center;
  }
  .seg span {
    padding: 0.3rem;
    border-radius: 6px;
    color: #919c97;
  }
  .seg .on {
    background: #303637;
    color: var(--text);
  }
  .branch {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0.9rem 0.3rem 0.5rem;
    color: var(--text);
  }
  .branch svg {
    color: var(--mint);
  }
  .ahead {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--mint);
  }
  .group {
    display: flex;
    justify-content: space-between;
    margin: 0.8rem 0.3rem 0.3rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #727f78;
  }
  .file {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0.4rem;
    border-radius: 6px;
    color: #dce2df;
  }
  .file.sel {
    background: rgba(166, 221, 194, 0.12);
  }
  .file em {
    margin-left: auto;
    font-style: normal;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: #727f78;
  }
  .m {
    width: 1rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--modified);
  }
  .m.a {
    color: var(--added);
  }
  .hunk {
    margin: 0.5rem 0 0.8rem;
    border-radius: 8px;
    overflow: hidden;
    background: var(--editor);
    border: 1px solid rgba(255, 255, 255, 0.05);
    font-family: var(--mono);
    font-size: 0.74rem;
    line-height: 1.75;
  }
  .hunk-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.3rem 0.6rem;
    color: #727f78;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .stage {
    font-family: var(--sans);
    font-size: 0.7rem;
    padding: 0.1rem 0.5rem;
    border-radius: 5px;
    background: rgba(166, 221, 194, 0.14);
    color: var(--mint);
  }
  .h {
    padding: 0 0.6rem 0 1.2rem;
    color: #dce2df;
    white-space: pre;
  }
  .h.add {
    background: rgba(90, 179, 115, 0.13);
    box-shadow: inset 3px 0 0 var(--added);
  }
  .h.del {
    background: rgba(221, 101, 93, 0.13);
    box-shadow: inset 3px 0 0 var(--removed);
  }
  .k { color: var(--kw); }
  .t { color: var(--type); }
  .commit {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .msg {
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(166, 221, 194, 0.35);
    color: var(--text);
  }
  .go {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    border-radius: 8px;
    background: var(--mint);
    color: #102019;
    font-weight: 600;
  }
  .go kbd {
    font-family: var(--sans);
    font-size: 0.72rem;
    opacity: 0.65;
  }
</style>
