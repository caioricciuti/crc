---
import { Image } from "astro:assets";
import Landing from "../layouts/Landing.astro";
import ClaudeMock from "../components/landing/ClaudeMock.astro";
import CompletionMock from "../components/landing/CompletionMock.astro";
import GitMock from "../components/landing/GitMock.astro";
import editorDark from "../assets/editor-dark.png";
import editorLight from "../assets/editor-light.png";
import terminalDark from "../assets/terminal-dark.png";
import homeDark from "../assets/home-dark.png";

const release = "https://github.com/caioricciuti/crc/releases/latest";

const shots = [
  { label: "Editor", src: editorDark, alt: "crc editing a Rust file: syntax colours, indent guides, a Git mark in the gutter and the project sidebar." },
  { label: "Terminal", src: terminalDark, alt: "crc with a terminal panel open under the editor, running zsh in the project folder." },
  { label: "Light", src: editorLight, alt: "The same Rust file in crc's light appearance." },
  { label: "Home", src: homeDark, alt: "crc's home screen with Start actions, recent folders and a short list of keys." },
];

const languages = [
  ["Rust", "#f6a35b"],
  ["Python", "#82aaff"],
  ["TypeScript", "#82aaff"],
  ["TSX", "#89ddff"],
  ["JavaScript", "#e9c46a"],
  ["JSX", "#89ddff"],
  ["Go", "#7fd1c2"],
  ["C", "#b7c0bc"],
  ["C++", "#c792ea"],
  ["HTML", "#e29c96"],
  ["CSS", "#c792ea"],
  ["JSON", "#a5d68a"],
  ["TOML", "#f0a3c9"],
  ["YAML", "#e2a43a"],
  ["Shell", "#98cf9f"],
];

const keys = [
  [["⌘", "P"], "Open any file"],
  [["⌘", "P", ">"], "Run any menu command"],
  [["⌘", "⇧", "F"], "Find in project"],
  [["⌘", "D"], "Next occurrence as a cursor"],
  [["⌘", "⇧", "C"], "Claude Code tab"],
  [["⌃", "`"], "Terminal panel"],
  [["⌘", "⌥", "G"], "Source Control"],
  [["⌘", "\\"], "Split right"],
  [["F12"], "Go to definition"],
  [["F2"], "Rename symbol"],
  [["⌘", "E"], "Markdown preview"],
  [["⌥", "Z"], "Word wrap"],
];
---

<Landing
  title="crc: the editor that keeps up with you"
  description="A native macOS text editor drawn on the GPU with Metal and CoreText. Terminal, local Git and Claude Code built in. 0.8 ms keystroke to GPU."
>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="aurora a1"></div>
      <div class="aurora a2"></div>
      <div class="aurora a3"></div>
      <div class="grid"></div>
    </div>

    <div class="container hero-copy">
      <a class="pill" href="/changelog/">
        <span class="pill-tag">New</span>
        <span>v0.2.0-alpha.1 is out for Apple Silicon</span>
        <svg class="arrow" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M6 3l5 5-5 5"/></svg>
      </a>
      <h1 class="h1">
        The editor that<br /><span class="grad">keeps up with you.</span>
      </h1>
      <p class="sub">
        A native macOS editor drawn on the GPU straight from Metal and CoreText.
        Terminal, Git and Claude Code built in. No Electron, no web view,
        and <strong>0.8&nbsp;ms</strong> from keystroke to GPU in a 100&nbsp;MiB file.
      </p>
      <div class="cta">
        <a class="btn btn-light btn-lg" href={release}>
          <svg viewBox="0 0 814 1000" width="15" height="18" aria-hidden="true"><path fill="currentColor" d="M788 341c-6 4-107 61-107 187 0 146 128 198 132 199-1 3-20 70-67 138-42 60-86 120-152 120s-83-38-159-38c-74 0-101 40-161 40s-103-56-151-124C66 783 21 660 21 543c0-187 122-287 242-287 64 0 117 42 157 42 38 0 98-45 171-45 28 0 128 3 197 88zM554 167c30-35 51-84 51-133 0-7-1-14-2-19-49 2-107 33-142 73-27 31-53 80-53 130 0 7 1 15 2 17 3 1 8 1 13 1 44 0 99-30 131-69z"/></svg>
          Download for macOS
        </a>
        <a class="btn btn-ghost btn-lg" href="/docs/">
          Read the docs
          <svg class="arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
      </div>
      <p class="meta">
        <span>Apple Silicon</span><span>macOS 14+</span><span>Signed &amp; notarized</span><span>Free &amp; open source</span>
      </p>
    </div>

    <div class="container stage-wrap">
      <div class="switch" role="tablist" aria-label="Screenshots">
        {shots.map((s, i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-shot={i}>{s.label}</button>
        ))}
        <span class="switch-glider" aria-hidden="true"></span>
      </div>
      <div class="stage">
        <div class="stage-glow" aria-hidden="true"></div>
        <div class="stage-frame">
          {shots.map((s, i) => (
            <Image
              src={s.src}
              alt={s.alt}
              class:list={["shot", { on: i === 0 }]}
              data-shot-img={i}
              widths={[800, 1400, 2000]}
              sizes="(max-width: 76rem) 100vw, 72rem"
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ================= STATS ================= -->
  <section class="stats-band">
    <div class="container stats" data-reveal>
      <div><strong>0.8<small>ms</small></strong><span>keystroke to GPU, p99,<br />in a 100 MiB file</span></div>
      <div><strong>14</strong><span>crates in the whole<br />dependency tree</span></div>
      <div><strong>17<small>MB</small></strong><span>on disk, signed<br />and notarized</span></div>
      <div><strong>0</strong><span>web views, JS runtimes<br />or telemetry</span></div>
    </div>
  </section>

  <!-- ================= CLAUDE ================= -->
  <section class="section" id="claude">
    <div class="container split">
      <div class="split-copy" data-reveal>
        <span class="eyebrow">Claude Code, inside</span>
        <h2 class="h2">An agent that edits<br /><span class="soft">where you can see it.</span></h2>
        <p class="lead">
          Type <code>claude</code> in any crc terminal and it connects to the window by itself,
          or press <kbd class="key">⌘</kbd><kbd class="key">⇧</kbd><kbd class="key">C</kbd> for a Claude tab.
          Every change it proposes opens as a diff you accept or reject.
        </p>
        <ul class="checks">
          <li><b>Context without copy-paste.</b> Claude sees the file and selection you are on, and the language server diagnostics.</li>
          <li><b>Diffs, not surprises.</b> Accept with <kbd class="key">⌘</kbd><kbd class="key">↩</kbd>, reject with <kbd class="key">Esc</kbd>.</li>
          <li><b>Live files.</b> Anything Claude writes to disk shows up in its tab at once.</li>
          <li><b>Local only.</b> The bridge listens on 127.0.0.1 behind a random token readable by you alone.</li>
        </ul>
        <a class="more" href="/docs/features/claude-code/">How the bridge works <span>→</span></a>
      </div>
      <div class="split-visual" data-reveal>
        <div class="visual-bg v-claude" aria-hidden="true"></div>
        <ClaudeMock />
      </div>
    </div>
  </section>

  <!-- ================= COMPLETION ================= -->
  <section class="section tight" id="features">
    <div class="container split reverse">
      <div class="split-copy" data-reveal>
        <span class="eyebrow">Completion that learns</span>
        <h2 class="h2">It tells you why<br /><span class="soft">it guessed that.</span></h2>
        <p class="lead">
          The best guess appears as ghost text at the caret; the alternatives sit
          in one row of chips under the line. A single line explains the pick:
          where it is defined, how often it is used, how often you chose it after
          the same receiver.
        </p>
        <div class="sources">
          <span>Language server</span>
          <span>Project index (SQLite)</span>
          <span>Nearby words</span>
          <span>Paths &amp; imports</span>
          <span>Your own history</span>
        </div>
        <p class="fine">History stays on your Mac. Go &gt; Forget Completion History clears it.</p>
      </div>
      <div class="split-visual" data-reveal>
        <div class="visual-bg v-complete" aria-hidden="true"></div>
        <CompletionMock />
      </div>
    </div>
  </section>

  <!-- ================= TERMINAL + GIT ================= -->
  <section class="section tight">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Terminal and Git</span>
        <h2 class="h2">Your shell and your repo,<br /><span class="soft">one keystroke away.</span></h2>
        <p class="lead">
          Terminal sessions run your login shell in the project folder on an
          xterm-compatible emulator written for crc. Source Control stages whole
          files or single hunks, commits, switches branches, fetches, pulls and pushes.
        </p>
      </div>
      <div class="tg" data-reveal>
        <div class="tg-shot">
          <Image src={terminalDark} alt="The terminal panel under the editor, with a zsh prompt in the project folder." widths={[800, 1400]} sizes="(max-width: 60rem) 100vw, 48rem" />
        </div>
        <div class="tg-git">
          <GitMock />
        </div>
      </div>
      <div class="tg-facts" data-reveal>
        <div><b>24-bit colour</b><span>scroll regions, alternate screen, bracketed paste</span></div>
        <div><b>⌘-click a path</b><span><code>src/main.rs:42:7</code> in any output opens that line</span></div>
        <div><b>Hunk staging</b><span>stage or unstage one change at a time</span></div>
        <div><b>Blame in the status line</b><span>who changed the caret's line, and when</span></div>
      </div>
    </div>
  </section>

  <!-- ================= SPEED ================= -->
  <section class="section speed" id="speed">
    <div class="speed-bg" aria-hidden="true"></div>
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Performance</span>
        <h2 class="h2">A tenth of a frame.<br /><span class="soft">In a 100 MiB file.</span></h2>
        <p class="lead">
          At 120 Hz a frame lasts 8.333 ms. crc goes from keystroke to finished GPU work
          in 0.803 ms at p99 with the caret halfway through 2.7 million lines. The
          harness ships in the repository, so you can measure it yourself.
        </p>
      </div>

      <div class="bench" data-reveal>
        <div class="bench-row">
          <div class="bench-label"><b>Editor viewport</b><span>p99, keystroke to GPU completion</span></div>
          <div class="bench-track"><div class="bench-bar" style="--w: 9.64%"></div></div>
          <div class="bench-val">0.803 ms</div>
        </div>
        <div class="bench-row">
          <div class="bench-label"><b>With toolbar, sidebar, tabs, status</b><span>the whole window</span></div>
          <div class="bench-track"><div class="bench-bar alt" style="--w: 12.1%"></div></div>
          <div class="bench-val">1.009 ms</div>
        </div>
        <div class="bench-row budget">
          <div class="bench-label"><b>One frame at 120 Hz</b><span>the budget</span></div>
          <div class="bench-track"><div class="bench-bar ghost" style="--w: 100%"></div></div>
          <div class="bench-val">8.333 ms</div>
        </div>
        <div class="bench-code">
          <span class="dim">$</span> cargo run --release --offline --example frame_latency <span class="dim">-- --chrome</span>
        </div>
      </div>

      <div class="why-fast" data-reveal>
        <div>
          <span class="n">01</span>
          <h3>One draw call per frame</h3>
          <p>Every glyph is an instance of one quad. A screen of text is a single <code>drawPrimitives</code>.</p>
        </div>
        <div>
          <span class="n">02</span>
          <h3>Only what you can see</h3>
          <p>Layout touches the visible lines, so a 100 MiB file costs what a small one does.</p>
        </div>
        <div>
          <span class="n">03</span>
          <h3>A persistent rope</h3>
          <p>Our own B-tree. Cloning is O(1), which makes undo snapshots and background parsing cheap.</p>
        </div>
        <div>
          <span class="n">04</span>
          <h3>Metal and CoreText</h3>
          <p>The OS's own text shaping and GPU API, reached directly. No browser engine in between.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= BENTO ================= -->
  <section class="section" id="more">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Everything else</span>
        <h2 class="h2">Everything an editor needs.<br /><span class="soft">Nothing it doesn't.</span></h2>
      </div>

      <div class="bento" data-reveal>
        <article class="card c-wide">
          <div class="card-art art-palette" aria-hidden="true">
            <div class="pal">
              <div class="pal-input"><span class="q">&gt;</span> sw<span class="caret"></span></div>
              <div class="pal-row on"><span>Git: <b>Sw</b>itch Branch…</span></div>
              <div class="pal-row"><span>View: <b>S</b>plit Editor Right</span><kbd>⌘\</kbd></div>
              <div class="pal-row"><span>Go: Go to <b>S</b>ymbol in Project…</span><kbd>⌘T</kbd></div>
              <div class="pal-row"><span>View: <b>W</b>ord Wrap</span><kbd>⌥Z</kbd></div>
            </div>
          </div>
          <h3>Open Quickly, and every command</h3>
          <p><kbd class="key">⌘</kbd><kbd class="key">P</kbd> fuzzy-finds any file. Type <code>&gt;</code> in the same box to run any menu command.</p>
        </article>

        <article class="card">
          <div class="card-art art-split" aria-hidden="true">
            <i></i><i></i><i></i><i></i>
          </div>
          <h3>Split panes</h3>
          <p>Up to four, each with its own tabs. <kbd class="key">⌘</kbd><kbd class="key">\</kbd></p>
        </article>

        <article class="card">
          <div class="card-art art-cursors" aria-hidden="true">
            <div><span class="k">let</span> bed<span class="mc"></span> = 3;</div>
            <div><span class="k">let</span> bed<span class="mc"></span> = 7;</div>
            <div><span class="k">let</span> bed<span class="mc"></span> = 9;</div>
          </div>
          <h3>Multiple cursors</h3>
          <p><kbd class="key">⌘</kbd><kbd class="key">D</kbd> for the next match, Option-click for anywhere.</p>
        </article>

        <article class="card c-tall">
          <div class="card-art art-http" aria-hidden="true">
            <div class="req">
              <div><span class="c">### Create a bed</span></div>
              <div><span class="k">POST</span> <span class="u">{"{{host}}"}/beds</span></div>
              <div><span class="t">Content-Type:</span> application/json</div>
              <div>&nbsp;</div>
              <div>{"{"}<span class="s">"name"</span>: <span class="s">"north"</span>{"}"}</div>
            </div>
            <div class="res">
              <div class="res-head"><span class="ok">201 Created</span><span>84 ms</span></div>
              <div>{"{"}</div>
              <div>&nbsp;&nbsp;<span class="p">"id"</span>: <span class="n">12</span>,</div>
              <div>&nbsp;&nbsp;<span class="p">"name"</span>: <span class="s">"north"</span></div>
              <div>{"}"}</div>
            </div>
          </div>
          <h3>HTTP requests from <code>.http</code> files</h3>
          <p>The JetBrains and VS Code REST Client format, with environments. <kbd class="key">⌘</kbd><kbd class="key">↩</kbd> sends the request under the caret; the response opens in a tab.</p>
        </article>

        <article class="card">
          <div class="card-art art-lsp" aria-hidden="true">
            <span>rust-analyzer</span><span>gopls</span><span>pyright</span><span>typescript-language-server</span><span>clangd</span>
          </div>
          <h3>Language servers</h3>
          <p>Definition, hover, references, rename, format and signature help. Found where you installed them.</p>
        </article>

        <article class="card">
          <div class="card-art art-dialog" aria-hidden="true">
            <div class="dlg">
              <b>garden.yaml changed on disk</b>
              <span>You have unsaved edits.</span>
              <div class="dlg-btns"><i>Reload</i><i>Cancel</i><i class="pri">Overwrite</i></div>
            </div>
          </div>
          <h3>Files you can trust</h3>
          <p>Atomic saves that keep mode and symlinks. Crash recovery for unsaved text. Every encoding and line ending preserved.</p>
        </article>

        <article class="card">
          <div class="card-art art-md" aria-hidden="true">
            <div class="md-src"><span class="c">## </span>Beds<br /><span class="c">- </span>north: <span class="c">**</span>tomato<span class="c">**</span></div>
            <div class="md-out"><b>Beds</b><span>• north: <strong>tomato</strong></span></div>
          </div>
          <h3>Markdown, rendered</h3>
          <p>Renders in place as you type, with a preview on <kbd class="key">⌘</kbd><kbd class="key">E</kbd>. Images, PDFs and media open in Quick Look.</p>
        </article>

        <article class="card c-full">
          <div class="card-art art-fold" aria-hidden="true">
            <div><span class="chev">›</span><span class="k">pub fn</span> <span class="f">read_log</span>(path: &amp;<span class="t">Path</span>) <span class="folded">{"{ … }"}</span></div>
            <div><span class="chev open">›</span><span class="k">pub fn</span> <span class="f">plantings_per_bed</span>(entries: &amp;[<span class="t">Entry</span>]) {"{"}</div>
            <div class="in">    <span class="k">let mut</span> beds = <span class="t">BTreeMap</span>::<span class="f">new</span>();  <span class="c">// long lines wrap on ⌥Z, and wrap by default in Markdown</span></div>
          </div>
          <h3>Folding, word wrap and the rest</h3>
          <p>Fold a block or the whole file, wrap long lines, go to symbol, find and replace with regex, comment toggle, line move and duplicate, Emacs motions, full Unicode with emoji and CJK, session restore.</p>
        </article>
      </div>

      <div class="langs" data-reveal>
        <p>Highlighting via tree-sitter, compiled from vendored C</p>
        <div class="marquee">
          <div class="marquee-track">
            {[...languages, ...languages].map(([name, color], i) => (
              <span class:list={["lang", { dup: i >= languages.length }]} aria-hidden={i >= languages.length ? "true" : undefined}><i style={`background:${color}`}></i>{name}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= KEYBOARD ================= -->
  <section class="section tight keys-section">
    <div class="container split">
      <div class="split-copy" data-reveal>
        <span class="eyebrow">Keyboard first</span>
        <h2 class="h2">Your hands<br /><span class="soft">never leave the keys.</span></h2>
        <p class="lead">
          macOS conventions where they exist, the bindings every editor shares where
          they don't, and the Emacs motions your fingers already know.
        </p>
        <a class="more" href="/docs/reference/keyboard-shortcuts/">All keyboard shortcuts <span>→</span></a>
      </div>
      <div class="keygrid" data-reveal>
        {keys.map(([combo, label]) => (
          <div class="keyrow">
            <span class="combo">{(combo as string[]).map((k) => <kbd class="key">{k}</kbd>)}</span>
            <span>{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= TRUST ================= -->
  <section class="section trust" id="trust">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">Supply chain</span>
        <h2 class="h2">Read, not trusted.</h2>
        <p class="lead">
          Cargo runs build scripts and proc macros with no allowlist and no minimum release age.
          So crc keeps its tree small enough to read, and CI fails if that changes.
        </p>
      </div>
      <div class="trust-grid" data-reveal>
        <div class="trust-num"><strong>14</strong><span>crates, every one pinned to an exact version</span></div>
        <div class="trust-num"><strong>1</strong><span>build script, read line by line</span></div>
        <div class="trust-num"><strong>0</strong><span>proc macros anywhere in the tree</span></div>
      </div>
      <div class="compare" data-reveal>
        <div class="compare-row head"><span>Adding tree-sitter</span><span>Crates</span><span>Build scripts</span><span>Proc macros</span></div>
        <div class="compare-row"><span>As the crates.io crate</span><span>29</span><span>10</span><span>1</span></div>
        <div class="compare-row us"><span>As vendored C, crc's own build.rs</span><span>0</span><span>1</span><span>0</span></div>
      </div>
      <p class="trust-foot" data-reveal>
        Signed with a Developer ID and notarized. Grammars pinned by checksum. GitHub Actions pinned by commit.{" "}
        <a href="/dependency-review/">Read the dependency review →</a>
      </p>
    </div>
  </section>

  <!-- ================= HONEST ================= -->
  <section class="section tight">
    <div class="container honest" data-reveal>
      <div>
        <span class="eyebrow warn">An honest alpha</span>
        <h2 class="h2">What it doesn't do yet.</h2>
        <p class="lead">Used every day by its author, now going to a small group of testers. Passing tests are not a stability guarantee.</p>
        <a class="more" href="/docs/reference/limitations/">Every known limit <span>→</span></a>
      </div>
      <ul class="nots">
        <li><b>macOS on Apple Silicon only.</b> No Intel build, no Linux or Windows plans.</li>
        <li><b>A fixed set of grammars.</b> No SQL highlighting in the alpha.</li>
        <li><b>No code actions</b> from language servers, and no minimap.</li>
        <li><b>A file lives in one pane at a time.</b></li>
        <li><b>Updates are announced, not installed.</b> Nothing downloads itself.</li>
        <li><b>No extensions yet.</b> WASM with declared capabilities is the plan.</li>
      </ul>
    </div>
  </section>

  <!-- ================= FINAL CTA ================= -->
  <section class="final">
    <div class="final-bg" aria-hidden="true"></div>
    <div class="container final-inner" data-reveal>
      <img src="/favicon.svg" alt="" width="72" height="72" class="final-icon" />
      <h2 class="h2">Try the alpha.</h2>
      <p class="lead">Seventeen megabytes. Opens without a Gatekeeper warning. Drag it to Applications and open a folder.</p>
      <div class="cta center">
        <a class="btn btn-light btn-lg" href={release}>
          <svg viewBox="0 0 814 1000" width="15" height="18" aria-hidden="true"><path fill="currentColor" d="M788 341c-6 4-107 61-107 187 0 146 128 198 132 199-1 3-20 70-67 138-42 60-86 120-152 120s-83-38-159-38c-74 0-101 40-161 40s-103-56-151-124C66 783 21 660 21 543c0-187 122-287 242-287 64 0 117 42 157 42 38 0 98-45 171-45 28 0 128 3 197 88zM554 167c30-35 51-84 51-133 0-7-1-14-2-19-49 2-107 33-142 73-27 31-53 80-53 130 0 7 1 15 2 17 3 1 8 1 13 1 44 0 99-30 131-69z"/></svg>
          Download for macOS
        </a>
        <a class="btn btn-ghost btn-lg" href="/docs/getting-started/installation/">Build from source</a>
      </div>
      <pre class="final-code"><span class="dim">$</span> open -a crc .</pre>
    </div>
  </section>
</Landing>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-shot]"));
  const imgs = Array.from(document.querySelectorAll<HTMLElement>("[data-shot-img]"));
  const glider = document.querySelector<HTMLElement>(".switch-glider");
  let current = 0;
  let timer: number | undefined;

  function place(tab: HTMLElement) {
    if (!glider) return;
    glider.style.width = `${tab.offsetWidth}px`;
    glider.style.transform = `translateX(${tab.offsetLeft}px)`;
  }

  function show(i: number) {
    current = i;
    tabs.forEach((t, n) => t.setAttribute("aria-selected", String(n === i)));
    imgs.forEach((img, n) => img.classList.toggle("on", n === i));
    place(tabs[i]);
  }

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  function auto() {
    if (reduce) return;
    window.clearInterval(timer);
    timer = window.setInterval(() => show((current + 1) % tabs.length), 5000);
  }

  tabs.forEach((t, i) =>
    t.addEventListener("click", () => {
      show(i);
      window.clearInterval(timer);
    }),
  );
  window.addEventListener("resize", () => place(tabs[current]));
  requestAnimationFrame(() => place(tabs[0]));
  document.fonts?.ready.then(() => place(tabs[current]));

  // Only rotate while the screenshot is on screen.
  const stage = document.querySelector(".stage");
  if (stage && "IntersectionObserver" in window) {
    new IntersectionObserver(([e]) => (e.isIntersecting ? auto() : window.clearInterval(timer))).observe(stage);
  }
</script>

